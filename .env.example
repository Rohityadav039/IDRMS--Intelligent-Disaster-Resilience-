PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
OPENWEATHER_API_KEY=
DEFAULT_LAT=26.1445
DEFAULT_LNG=91.7362
DEFAULT_CITY=Guwahati

# --- Supabase (fill in to enable live Postgres + Storage; app falls back to
# local JSON + local disk automatically when these are blank) ---
SUPABASE_URL=
# Either key works for table reads/writes; SERVICE_ROLE is preferred when set
# because it also bypasses Storage RLS for photo uploads (see supabaseClient.js).
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket used for sponsor equipment photos, landslide ground-report
# photos, and citizen field-report photos. Create it via supabase_schema.sql
# or manually in Supabase Studio > Storage.
SUPABASE_MEDIA_BUCKET=idrms-media
